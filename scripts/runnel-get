#!/usr/bin/env python3
"""runnel-get: Cross-platform CLI client for a runnel gateway.

Uses RUNNEL_URL when set and otherwise connects to localhost. Zero external
dependencies beyond Python itself (pure Python standard library).
"""
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
from html.parser import HTMLParser

LOCALHOST = "http://127.0.0.1:8090"

CANDIDATES = [LOCALHOST]
if os.environ.get("RUNNEL_URL"):
    CANDIDATES.insert(0, os.environ["RUNNEL_URL"].rstrip("/"))


class MarkdownExtractor(HTMLParser):
    """Small, dependency-free HTML-to-readable-Markdown converter."""

    SKIPPED_TAGS = {"script", "style", "svg", "nav", "footer", "noscript", "template", "form"}
    BLOCK_TAGS = {"article", "aside", "blockquote", "div", "header", "main", "p", "section", "table", "tr"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.parts = []
        self.skipped_depth = 0
        self.in_pre = False

    def handle_starttag(self, tag, attrs):
        tag = tag.lower()
        if self.skipped_depth:
            if tag in self.SKIPPED_TAGS:
                self.skipped_depth += 1
            return
        if tag in self.SKIPPED_TAGS:
            self.skipped_depth = 1
        elif tag in {"h1", "h2", "h3", "h4", "h5", "h6"}:
            self.parts.append("\n\n" + "#" * int(tag[1]) + " ")
        elif tag == "li":
            self.parts.append("- " if self.parts and self.parts[-1].endswith("\n") else "\n- ")
        elif tag == "br":
            self.parts.append("\n")
        elif tag == "pre":
            self.in_pre = True
            self.parts.append("\n\n```\n")
        elif tag in self.BLOCK_TAGS:
            self.parts.append("\n\n")

    def handle_endtag(self, tag):
        tag = tag.lower()
        if self.skipped_depth:
            if tag in self.SKIPPED_TAGS:
                self.skipped_depth -= 1
            return
        if tag == "pre":
            self.in_pre = False
            self.parts.append("\n```\n")
        elif tag in self.BLOCK_TAGS or tag in {"li", "h1", "h2", "h3", "h4", "h5", "h6"}:
            self.parts.append("\n")

    def handle_data(self, data):
        if self.skipped_depth or not data:
            return
        if self.in_pre:
            self.parts.append(data)
            return
        text = re.sub(r"\s+", " ", data)
        if text.strip():
            self.parts.append(text)

    def markdown(self):
        text = "".join(self.parts)
        lines = []
        in_code = False
        for line in text.splitlines():
            if line.strip() == "```":
                in_code = not in_code
                lines.append("```")
            elif in_code:
                lines.append(line.rstrip())
            else:
                lines.append(re.sub(r"[ \t]+", " ", line).strip())
        text = "\n".join(lines)
        return re.sub(r"\n{3,}", "\n\n", text).strip() + "\n"


def html_to_markdown(body, charset="utf-8"):
    parser = MarkdownExtractor()
    parser.feed(body.decode(charset or "utf-8", errors="replace"))
    parser.close()
    return parser.markdown().encode("utf-8")


def find_active_gateway():
    for base in CANDIDATES:
        try:
            req = urllib.request.Request(f"{base}/_healthz", headers={"User-Agent": "runnel-probe"})
            with urllib.request.urlopen(req, timeout=1.5) as resp:
                if resp.status == 200:
                    return base
        except Exception:
            continue
    return None


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print("Kullanım: runnel-get [--output raw|markdown] [-H 'Header: Value'] <URL>")
        print("Örnek:")
        print("  runnel-get 'https://api.github.com/zen'")
        print("  runnel-get --output markdown 'https://example.com'")
        sys.exit(0 if len(sys.argv) > 1 else 1)

    custom_headers = {}
    output = "raw"
    target_url = None

    args = sys.argv[1:]
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("--no-cache", "--fresh", "-f"):
            custom_headers["Cache-Control"] = "no-cache"
            i += 1
        elif arg == "--output" and i + 1 < len(args):
            output = args[i + 1]
            i += 2
        elif arg.startswith("--output="):
            output = arg.split("=", 1)[1]
            i += 1
        elif arg == "-H" and i + 1 < len(args):
            hdr = args[i + 1]
            if ":" in hdr:
                k, v = hdr.split(":", 1)
                custom_headers[k.strip()] = v.strip()
            i += 2
        elif not arg.startswith("-"):
            target_url = arg
            i += 1
        else:
            i += 1

    if not target_url:
        print("Hata: Hedef URL belirtilmedi.", file=sys.stderr)
        sys.exit(1)
    if output not in ("raw", "markdown"):
        print("Hata: --output yalnızca raw veya markdown olabilir.", file=sys.stderr)
        sys.exit(1)

    gateway = find_active_gateway()
    if not gateway:
        print("Hata: runnel gateway'e ulaşılamadı. RUNNEL_URL değerini kontrol edin.", file=sys.stderr)
        sys.exit(2)

    proxy_url = f"{gateway}/proxy?url={urllib.parse.quote(target_url, safe='')}"
    req = urllib.request.Request(proxy_url, headers=custom_headers)

    try:
        with urllib.request.urlopen(req, timeout=35) as resp:
            body = resp.read()
            if output == "markdown" and resp.headers.get_content_type() == "text/html":
                body = html_to_markdown(body, resp.headers.get_content_charset())
            sys.stdout.buffer.write(body)
            sys.stdout.flush()
    except urllib.error.HTTPError as e:
        sys.stderr.write(f"HTTP Hata: {e.code} {e.reason}\n")
        try:
            sys.stderr.buffer.write(e.read())
            sys.stderr.flush()
        except Exception:
            pass
        sys.exit(e.code)
    except Exception as e:
        print(f"Bağlantı hatası: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
